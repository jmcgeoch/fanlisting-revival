PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
DB_PATH=./data/fanlisting.db

LISTING_NAME="My Fanlisting"
OWNER_EMAIL=owner@example.com

# Leave SMTP_HOST blank to run without sending real email (emails are logged
# to the console instead) — handy for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Fanlisting <no-reply@example.com>"
