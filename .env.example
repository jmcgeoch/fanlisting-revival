# Set to "production" when deploying. In production the app refuses to start
# without SESSION_SECRET and APP_URL, and enables secure cookies.
NODE_ENV=development

PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
DB_PATH=./data/fanlisting.db

# Public base URL of the site, used to build links inside emails. REQUIRED in
# production — otherwise emailed links trust the request's Host header, which
# an attacker can forge. Leave blank in development to use the request host.
APP_URL=

# Where "new member joined" notifications are sent. Your listing name and
# other public details are set in the app at Admin -> Settings, not here.
OWNER_EMAIL=owner@example.com

# Leave SMTP_HOST blank to run without sending real email (emails are logged
# to the console instead) — handy for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Fanlisting <no-reply@example.com>"
