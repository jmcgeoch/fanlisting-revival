{
    "name": "fanlisting-revival",
    "version": "1.0.0",
    "private": true,
    "description": "A modern, self-hosted fanlisting script.",
    "keywords": [
        "fanlisting",
        "self-hosted",
        "express",
        "sqlite",
        "handlebars"
    ],
    "license": "MIT",
    "author": "Jessica Zemartis",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jmcgeoch/fanlisting-revival.git"
    },
    "homepage": "https://github.com/jmcgeoch/fanlisting-revival#readme",
    "bugs": {
        "url": "https://github.com/jmcgeoch/fanlisting-revival/issues"
    },
    "main": "server.js",
    "engines": {
        "node": "^22.0.0 || ^24.0.0"
    },
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "create-admin": "node scripts/create-admin.js",
        "test": "node --test test/*.test.js",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "format:views": "html-beautify -r --config .jsbeautifyrc views/*/*.handlebars"
    },
    "dependencies": {
        "better-sqlite3": "^11.3.0",
        "csrf-sync": "^4.2.1",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-handlebars": "^7.1.2",
        "express-rate-limit": "^8.6.1",
        "express-session": "^1.18.0",
        "express-validator": "^7.2.0",
        "helmet": "^8.3.0",
        "nodemailer": "^9.0.3"
    },
    "devDependencies": {
        "js-beautify": "^2.0.3",
        "nodemon": "^3.1.4",
        "prettier": "^3.9.6",
        "supertest": "^7.2.2"
    }
}
