<h1>{{listing.name}} — Admin</h1>
<form method="POST" action="/admin/logout"><button type="submit">Log out</button></form>

<p>Pending: {{pendingCount}} | Approved: {{approvedCount}}</p>
<p><a href="/admin/members">Manage members</a></p>

<h2>Recent joins</h2>
<ul>
  {{#each recent}}
  <li>{{this.name}} — {{this.status}}</li>
  {{else}}
  <li>No members yet.</li>
  {{/each}}
</ul>
